        </aapt:attr>
    </path>
    <group>
        <clip-path android:pathData="M32,3 C28.7,7.3 12,28 12,41 C12,52 21,61 32,61 C43,61 52,52 52,41 C52,28 35.3,7.3 32,3 Z" />
