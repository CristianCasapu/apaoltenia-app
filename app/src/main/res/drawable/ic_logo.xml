                android:startY="10"
                android:endX="50"
                android:endY="60">
                <item android:offset="0.0" android:color="#FF4FA3D8" />
                <item android:offset="0.5" android:color="#FF0072BC" />
                <item android:offset="1.0" android:color="#FF005A96" />
