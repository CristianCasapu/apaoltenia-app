<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de baza (mod luminos). Material3 DayNight comuta automat pe
         varianta -night cand sistemul / utilizatorul alege modul intunecat. -->
    <style name="Theme.ApaOltenia" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Bara de sus brandata, coerenta cu antetul paginii web. -->
        <item name="toolbarStyle">@style/Widget.ApaOltenia.Toolbar</item>
        <item name="android:statusBarColor">@color/toolbar_bg</item>
    </style>

    <!-- Ecran de pornire (splash) cu marca aplicatiei pe fundal de brand.
         Instalat prin androidx.core:core-splashscreen; dupa splash trece la
         tema normala (postSplashScreenTheme). -->
    <style name="Theme.ApaOltenia.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ApaOltenia</item>
    </style>
</resources>
